AD_SERVICE_PORT=8080
ANALYTICS_SERVICE_PORT=8081

AD_DATABASE_URL=postgres://ads:ads@postgres-ads:5432/ads
ANALYTICS_DATABASE_URL=postgres://analytics:analytics@postgres-analytics:5432/analytics

REDIS_URL=redis://redis:6379

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

JWT_SECRET=change-me-in-production

RABBITMQ_EXCHANGE=ad-events
RABBITMQ_QUEUE=analytics-events
